# dependencies
node_modules/
.pnpm-store/

# build output
dist/
/functions/lib/
*.tsbuildinfo
.vite/
.turbo/

# env (the Firebase web config is public and lives in source; never commit real env files)
.env
.env.*
!.env.example
!.env.development
!.env.test
*.local

# firebase
.firebase/
.emulator-data/
firebase-debug*.log
firestore-debug*.log
ui-debug*.log
pubsub-debug*.log
database-debug*.log
*-debug.log
.runtimeconfig.json
serviceAccount*.json
*-service-account*.json

# test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp

# claude code local state
.claude/settings.local.json

# Claude's per-task git worktrees (one folder per task, created by the Claude Code agent)
.claude/worktrees/

# Reference screenshots of the owner's monday account (private)
docs/reference/monday/

# design-lint hook cache
.impeccable/

# per-copy emulator ports (generated by scripts/emulator-config.mjs; .env.local holds ATRIUM_PORT_OFFSET)
.firebase.emulators.json
.env.local

# visual tests: signed-in session, local-platform baselines (only Linux ones are committed)
tests/visual/.auth/
tests/visual/__screenshots__/*-win32.png
tests/visual/__screenshots__/*-darwin.png

# Private, local-only project ids and notes (never commit)
.private/
