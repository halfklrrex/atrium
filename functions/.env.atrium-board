# Non-secret Functions config, committed on purpose so CI deploys carry it.
ACCOUNT_APPROVAL_REQUIRED=true
# OPS4 hosted MCP connector kill switch: set to true by the enable PR (2026-11-11); false makes every route answer 503.
MCP_CONNECTOR_ENABLED=true
# P8 outgoing webhooks kill switch: false makes the webhook callables refuse, the producer queue nothing and the sweep exit at once. Flip to true in a PR after the smoke test (docs/DEPLOY.md).
WEBHOOKS_ENABLED=false
