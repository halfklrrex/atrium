{
  "name": "@atrium/visual-tests",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Playwright screenshot tests for key screens. Run through `pnpm test:visual` from the repo root (starts emulators and the dev server).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@atrium/shared": "workspace:*"
  },
  "devDependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.0",
    "firebase-admin": "^14.5.0",
    "typescript": "~6.0.3"
  }
}
